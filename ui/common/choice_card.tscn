[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/common/choice_card.gd" id="1_script"]
[ext_resource type="Theme" path="res://ui/theme/date_factory_theme.tres" id="2_theme"]

[node name="ChoiceCard" type="PanelContainer"]
custom_minimum_size = Vector2(0, 88)
size_flags_horizontal = 3
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="Content" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Text" type="VBoxContainer" parent="Margin/Content"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="TitleLabel" type="Label" parent="Margin/Content/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Вариант"
autowrap_mode = 2

[node name="DetailLabel" type="Label" parent="Margin/Content/Text"]
unique_name_in_owner = true
layout_mode = 2
text = "Описание"
autowrap_mode = 2

[node name="ActionButton" type="Button" parent="Margin/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 44)
layout_mode = 2
text = "Выбрать"
