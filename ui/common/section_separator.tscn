[gd_scene load_steps=2 format=3]

[ext_resource type="Theme" path="res://ui/theme/date_factory_theme.tres" id="1_theme"]

[node name="SectionSeparator" type="VBoxContainer"]
theme = ExtResource("1_theme")
theme_override_constants/separation = 4

[node name="Line" type="HSeparator" parent="."]
layout_mode = 2

[node name="Hint" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "[Нейтрально]"
horizontal_alignment = 1
