[gd_resource type="Resource" script_class="DatingEventDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://data/definitions/dating_event_definition.gd" id="1_script"]
[ext_resource type="Script" path="res://data/definitions/dating_action_definition.gd" id="2_action"]

[sub_resource type="Resource" id="Action_0"]
script = ExtResource("2_action")
id = &"date_action_cafe_reserved_sign_shift"
label = "Передвинуть свои вещи на свою половину"
characteristic = 0
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([2])
result_text = "Вещи съезжают на безопасную сторону; табличка остаётся править пустотой."

[sub_resource type="Resource" id="Action_1"]
script = ExtResource("2_action")
id = &"date_action_cafe_reserved_sign_compose"
label = "Перестроить сервировку вокруг таблички"
characteristic = 1
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([10])
result_text = "Табличка встраивается в композицию стола; бронь выглядит как элемент декора."

[sub_resource type="Resource" id="Action_2"]
script = ExtResource("2_action")
id = &"date_action_cafe_reserved_sign_check"
label = "Уточнить бронь у администратора"
characteristic = 2
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([4])
result_text = "Администратор убирает табличку без извинений; стол снова принадлежит вам целиком."

[sub_resource type="Resource" id="Action_3"]
script = ExtResource("2_action")
id = &"date_action_cafe_reserved_sign_flip"
label = "Перевернуть табличку к пустому стулу и продолжить"
characteristic = 3
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([9])
result_text = "Табличка смотрит на пустой стул; вы продолжаете вечер, как будто бронь оформлена правильно."

[resource]
script = ExtResource("1_script")
id = &"date_event_cafe_reserved_sign"
category = 1
title = "Табличка на столе"
setup_text = "На пустой половине вашего стола внезапно появляется табличка «ЗАРЕЗЕРВИРОВАНО»."
actions = [SubResource("Action_0"), SubResource("Action_1"), SubResource("Action_2"), SubResource("Action_3")]
allowed_location_ids = Array[StringName]([&"cafe"])
