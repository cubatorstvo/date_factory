characteristic = 1
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([10])
result_text = "Ложка качается ровно по центру; дефект превращается в аккуратную деталь стола."

[sub_resource type="Resource" id="Action_2"]
script = ExtResource("2_action")
id = &"date_action_cafe_wobbly_spoon_set"
label = "Попросить заменить весь комплект"
