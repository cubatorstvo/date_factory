result_text = "Ты объявляешь обмен состоявшимся; оставшаяся куртка теперь считается вашей по ритуалу."

[resource]
script = ExtResource("1_script")
id = &"date_event_cafe_coat_mixup"
category = 2
title = "Чужая куртка"
setup_text = "Посетитель у выхода случайно берёт куртку, похожую на вашу."
