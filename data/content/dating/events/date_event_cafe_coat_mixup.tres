characteristic = 0
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([0])
result_text = "Ты догоняешь у двери и показываешь бирку; куртка возвращается без скандала."

[sub_resource type="Resource" id="Action_1"]
script = ExtResource("2_action")
id = &"date_action_cafe_coat_mixup_tag"
label = "Сначала проверить свою бирку"
