required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([4])
result_text = "Ты проверяешь бирку до претензий; ошибка выясняется без лишней драмы."

[sub_resource type="Resource" id="Action_2"]
script = ExtResource("2_action")
id = &"date_action_cafe_coat_mixup_buy"
label = "Сказать, что купишь другую"
characteristic = 2
required_characteristic_level = 0
resolver_id = &"direct"
