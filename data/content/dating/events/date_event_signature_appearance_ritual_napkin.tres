[resource]
script = ExtResource("1_script")
id = &"date_event_signature_appearance_ritual_napkin"
category = 2
title = "Угол салфетки"
setup_text = "Она кладёт салфетку ровно между двумя чашками и спрашивает, может ли вечер продолжаться, если угол не кратен семи."
