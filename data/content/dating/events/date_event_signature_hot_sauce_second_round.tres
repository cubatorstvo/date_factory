required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([6, 7])
is_public = true
result_text = "Зал получает право услышать, если жар победит."

[sub_resource type="Resource" id="Action_2"]
script = ExtResource("2_action")
id = &"date_action_sig_hotsauce_milk"
label = "Заказать молоко и отказаться"
