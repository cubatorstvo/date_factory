required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([9])
result_text = "VIP и обычная бронь для вас становятся одной и той же категорией."

[resource]
script = ExtResource("1_script")
id = &"date_event_signature_city_lanyard_reservation"
category = 1
title = "VIP без VIP"
setup_text = "На вашем столе стоит табличка «VIP», но бронь оформлена просто на имя."
