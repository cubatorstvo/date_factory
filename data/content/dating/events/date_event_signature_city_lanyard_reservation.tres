required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([3, 10])
result_text = "VIP остаётся декорацией, а заказ идёт по вашему сценарию."

[sub_resource type="Resource" id="Action_2"]
script = ExtResource("2_action")
id = &"date_action_sig_lanyard_claim"
