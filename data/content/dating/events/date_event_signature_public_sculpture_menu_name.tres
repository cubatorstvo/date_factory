[gd_resource type="Resource" script_class="DatingEventDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://data/definitions/dating_event_definition.gd" id="1_script"]
[ext_resource type="Script" path="res://data/definitions/dating_action_definition.gd" id="2_action"]

[sub_resource type="Resource" id="Action_0"]
script = ExtResource("2_action")
id = &"date_action_sig_sculpture_consequence"
label = "Назвать его «Последствие выбора»"
characteristic = 3
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([10, 9])
result_text = "Название зависает над пустой строкой меню как временный памятник."

[sub_resource type="Resource" id="Action_1"]
script = ExtResource("2_action")
id = &"date_action_sig_sculpture_shape"
label = "Придумать название по форме пустого места в меню"
characteristic = 1
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([10])
result_text = "Пустое поле получает имя, выведенное из его собственной дыры."

[sub_resource type="Resource" id="Action_2"]
script = ExtResource("2_action")
id = &"date_action_sig_sculpture_expensive"
label = "Выбрать самый дорогой десерт с нормальным названием"
characteristic = 2
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([3])
result_text = "Анонимный десерт остаётся без имени — на столе появляется статусный."

[sub_resource type="Resource" id="Action_3"]
script = ExtResource("2_action")
id = &"date_action_sig_sculpture_bring"
label = "Попросить просто принести десерт"
characteristic = 0
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([2])
result_text = "Официант кивает: безымянное всё равно принесут."

[resource]
script = ExtResource("1_script")
id = &"date_event_signature_public_sculpture_menu_name"
category = 2
title = "Имя десерта"
setup_text = "В меню есть десерт без фотографии. Она предлагает сначала дать ему название."
actions = [SubResource("Action_0"), SubResource("Action_1"), SubResource("Action_2"), SubResource("Action_3")]
allowed_location_ids = Array[StringName]([&"cafe"])
