[ext_resource type="Script" path="res://data/definitions/dating_action_definition.gd" id="2_action"]

[sub_resource type="Resource" id="Action_0"]
script = ExtResource("2_action")
id = &"date_action_cafe_table_photo_simple"
label = "Согласиться и сделать один простой кадр"
characteristic = 0
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([0, 2])
result_text = "Один кадр без режиссуры; компания благодарит и возвращается к своим чашкам."

[sub_resource type="Resource" id="Action_1"]
script = ExtResource("2_action")
id = &"date_action_cafe_table_photo_stage"
label = "Поставить их лучше и сделать нормальный кадр"
characteristic = 1
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([0, 3])
result_text = "Ты поправляешь посадку и свет; снимок получается заметно представительнее просьбы."

[sub_resource type="Resource" id="Action_2"]
script = ExtResource("2_action")
id = &"date_action_cafe_table_photo_pro"
label = "Предложить вызвать фотографа заведения"
characteristic = 2
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([3])
result_text = "Персонал подтверждает, что фотографа нет; предложение само звучит как уровень сервиса."

[sub_resource type="Resource" id="Action_3"]
script = ExtResource("2_action")
id = &"date_action_cafe_table_photo_concept"
label = "Попросить их сначала сформулировать концепцию снимка"
characteristic = 3
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([9])
result_text = "Компания спорит о концепции дольше, чем длится обычный кадр; ты ждёшь как куратор."

[resource]
script = ExtResource("1_script")
id = &"date_event_cafe_table_photo"
category = 0
title = "Сфотографируйте нас"
setup_text = "За соседним столом просят вас сфотографировать компанию."
