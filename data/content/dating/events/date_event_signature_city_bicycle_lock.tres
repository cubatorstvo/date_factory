[gd_resource type="Resource" script_class="DatingEventDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://data/definitions/dating_event_definition.gd" id="1_script"]
[ext_resource type="Script" path="res://data/definitions/dating_action_definition.gd" id="2_action"]

[sub_resource type="Resource" id="Action_0"]
script = ExtResource("2_action")
id = &"date_action_sig_bicycle_move_chair"
label = "Перенести стул вместе с велосипедом"
characteristic = 0
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([0, 10])
result_text = "Стул уезжает вместе с замком — место за столом снова свободно."

[sub_resource type="Resource" id="Action_1"]
script = ExtResource("2_action")
id = &"date_action_sig_bicycle_neighbor"
label = "Пересесть за соседний стол без объявления проблемы"
characteristic = 1
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([2])
result_text = "Вы тихо меняете стол, будто так и было задумано."

[sub_resource type="Resource" id="Action_2"]
script = ExtResource("2_action")
id = &"date_action_sig_bicycle_new_lock"
label = "Предложить оплатить владельцу новый замок"
characteristic = 2
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([3])
result_text = "Владелец принимает предложение, и стул освобождают без спора."

[sub_resource type="Resource" id="Action_3"]
script = ExtResource("2_action")
id = &"date_action_sig_bicycle_demand"
label = "Громко потребовать владельца освободить мебель"
characteristic = 3
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([7, 5])
result_text = "Холл напрягается; велосипед всё же отодвигают от вашего стула."

[resource]
script = ExtResource("1_script")
id = &"date_event_signature_city_bicycle_lock"
category = 1
title = "Велозамок у стула"
setup_text = "У входа чужой велосипед пристёгнут к вашему стулу."
