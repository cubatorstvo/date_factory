required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([6, 8])
result_text = "Вы сворачиваете к ярмарке — вечер становится громче."

[sub_resource type="Resource" id="Action_1"]
script = ExtResource("2_action")
id = &"date_action_sig_crosswalk_switch"
label = "Сначала пройти через набережную, потом резко сменить маршрут"
characteristic = 1
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([8, 10])
result_text = "Набережная обрывается внезапным поворотом на другой путь."

[sub_resource type="Resource" id="Action_2"]
script = ExtResource("2_action")
id = &"date_action_sig_crosswalk_car"
label = "Вызвать машину прямо ко входу"
