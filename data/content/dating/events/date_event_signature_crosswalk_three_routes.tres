[sub_resource type="Resource" id="Action_3"]
script = ExtResource("2_action")
id = &"date_action_sig_crosswalk_stick"
label = "Настоять на одном заранее выбранном маршруте"
characteristic = 3
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([4])
result_text = "Вы фиксируете один путь и не даёте спору разрастись."

[resource]
script = ExtResource("1_script")
id = &"date_event_signature_crosswalk_three_routes"
category = 2
title = "Три одинаковых пути"
setup_text = "После кафе можно идти домой тремя маршрутами одинаковой длины."
actions = [SubResource("Action_0"), SubResource("Action_1"), SubResource("Action_2"), SubResource("Action_3")]
allowed_location_ids = Array[StringName]([&"cafe"])
