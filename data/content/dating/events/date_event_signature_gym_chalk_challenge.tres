[gd_resource type="Resource" script_class="DatingEventDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://data/definitions/dating_event_definition.gd" id="1_script"]
[ext_resource type="Script" path="res://data/definitions/dating_action_definition.gd" id="2_action"]

[sub_resource type="Resource" id="Action_0"]
script = ExtResource("2_action")
id = &"date_action_sig_chalk_try"
label = "Принять спор и честно попробовать"
characteristic = 0
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([6, 7])
result_text = "Вы берёте стакан — спор из соседнего стола становится вашим."

[sub_resource type="Resource" id="Action_1"]
script = ExtResource("2_action")
id = &"date_action_sig_chalk_raise"
label = "Поднять ставку: проигравший объявляет результат всему кафе"
characteristic = 3
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([7])
is_public = true
result_text = "Зал слышит новые условия; спор раздувается до объявления."

[sub_resource type="Resource" id="Action_2"]
script = ExtResource("2_action")
id = &"date_action_sig_chalk_normal"
label = "Заказать обычный напиток"
characteristic = 2
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([2])
result_text = "Острый вызов остаётся чужим — на столе появляется спокойный заказ."

[sub_resource type="Resource" id="Action_3"]
script = ExtResource("2_action")
id = &"date_action_sig_chalk_ignore"
label = "Сделать вид, что спор относится к другому столу"
characteristic = 1
required_characteristic_level = 0
resolver_id = &"direct"
direct_tags = Array[int]([4])
result_text = "Вы держите дистанцию; спор бушует мимо вашего вечера."

[resource]
script = ExtResource("1_script")
id = &"date_event_signature_gym_chalk_challenge"
category = 1
title = "Спор про глоток"
setup_text = "За соседним столом кто-то спорит, что острый напиток невозможно допить залпом."
actions = [SubResource("Action_0"), SubResource("Action_1"), SubResource("Action_2"), SubResource("Action_3")]
allowed_location_ids = Array[StringName]([&"cafe"])
