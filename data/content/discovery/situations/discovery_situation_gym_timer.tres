[ext_resource type="Script" path="res://data/definitions/discovery_approach_definition.gd" id="1_approach"]
[ext_resource type="Resource" path="res://data/content/discovery/approaches/discovery_approach_gym_timer_repeat.tres" id="a0"]
[ext_resource type="Resource" path="res://data/content/discovery/approaches/discovery_approach_gym_timer_safe.tres" id="a1"]
[ext_resource type="Resource" path="res://data/content/discovery/approaches/discovery_approach_gym_timer_change.tres" id="a2"]

[resource]
script = ExtResource("1_script")
id = &"discovery_situation_gym_timer"
