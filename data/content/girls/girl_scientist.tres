speech_style_note = "Спокойная и методичная; прежде всего следит за тем, что эксперимент делает с живыми людьми. Хуже всего реагирует, когда уверенность героя превращается в давление."
clue_notes = Array[String](["Когда помощник говорит «наверное безопасно», она прекращает эксперимент раньше, чем он заканчивает фразу.", "Если человек честно говорит, что не понимает инструкцию, объясняет заново без раздражения.", "Фразу «потом разберёмся, кому стало хуже» записывает только в список запрещённых формулировок."])
