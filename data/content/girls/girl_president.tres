[gd_resource type="Resource" script_class="GirlDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/definitions/girl_definition.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"girl_president"
display_name = "Президент"
is_story = true
has_story_stage = true
story_stage = 5
primary_trait = 1
secondary_trait = 2
required_experience = 10
discovery_situation_id = &"discovery_situation_president_expansion_gate"
appearance_profile_id = &"appearance_female_president"
dating_pool_ids = Array[StringName]([&"date_pool_president"])
default_date_location_id = &"cafe"
dating_greeting_ids = Array[StringName]([&"dating_greeting_simple", &"dating_greeting_attention", &"dating_greeting_immediate_joke", &"dating_greeting_check_comfort"])
dating_farewell_id = &"dating_farewell_president"
speech_style_note = "Говорит так, будто даже бытовое решение должно иметь ответственного, публичную формулировку и официальный статус. Ценит контроль, престиж и способность занять позицию, но замечает, когда герой решает абсолютно всё одним инструментом."
clue_notes = Array[String](["Перед решением сначала выясняет, кто готов отвечать за него публично.", "Третий одинаковый аргумент подряд записывает как отсутствие второго инструмента.", "Демонстративную скромность считает не добродетелью, а плохо оформленной позицией."])
