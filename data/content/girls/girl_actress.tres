[gd_resource type="Resource" script_class="GirlDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/definitions/girl_definition.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"girl_actress"
display_name = "Актриса"
is_story = true
has_story_stage = true
story_stage = 1
primary_trait = 1
secondary_trait = 3
required_experience = 1
discovery_situation_id = &"discovery_situation_actress_waiting"
appearance_profile_id = &"appearance_female_actress"
dating_pool_ids = Array[StringName]([&"date_pool_cafe_common", &"date_pool_actress"])
default_date_location_id = &"cafe"
dating_greeting_ids = Array[StringName]([&"dating_greeting_simple", &"dating_greeting_attention", &"dating_greeting_immediate_joke", &"dating_greeting_check_comfort"])
dating_farewell_id = &"dating_farewell_early_common"
speech_style_note = "Привыкла к вниманию, быстро замечает качество подачи и отсутствие контроля; говорит так, будто вокруг всегда есть аудитория."
clue_notes = Array[String](["Перед разговором автоматически проверяет, кто на неё смотрит.", "Качественно организованную мелочь замечает быстрее, чем эмоциональный жест.", "Когда план разваливается на ходу, становится заметно холоднее."])
