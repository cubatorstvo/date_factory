; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DATE FACTORY"
config/description="Date Factory v2"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GodotIQRuntime="*uid://b2otg5noq2igh"
GameState="*res://game/state/game_state.gd"
ContentDB="*res://data/catalog/content_db.gd"
Progression="*res://game/progression/progression.gd"
GameDay="*res://game/day/game_day.gd"
RivalEncounters="*res://game/rivals/rival_encounters.gd"
RivalCompetitionRunner="*res://game/rivals/rival_competition_runner.gd"
GirlDiscovery="*res://game/girls/girl_discovery.gd"
DatingCore="*res://game/dating/dating_core.gd"
Relationships="*res://game/relationships/relationships.gd"
Story="*res://game/story/story.gd"
World="*res://world/world.gd"
SalaryMine="*res://game/salary/salary_mine.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/godotiq/plugin.cfg")

