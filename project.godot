; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DATE FACTORY"
config/description="Date System Lab"
config/version="0.1.0"
run/main_scene="res://game/simulator/GameSimulator.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GodotIQRuntime="*uid://b2otg5noq2igh"
GameState="*res://game/state/game_state.gd"
SaveManager="*res://game/save/save_manager.gd"
TimeService="*res://game/time/time_service.gd"
StageService="*res://game/story/stage_service.gd"
EconomyService="*res://game/economy/economy_service.gd"
ActionService="*res://game/actions/action_service.gd"
PurchaseService="*res://game/economy/purchase_service.gd"
WorldService="*res://game/world/world_service.gd"
GirlsService="*res://game/girls/girls_service.gd"
RatingService="*res://game/rating/rating_service.gd"
DatingService="*res://game/dating/dating_service.gd"
SceneTransitionService="*res://game/world/scene_transition_service.gd"

[debug]

file_logging/log_path="user://logs/date_factory.log"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_width=1280
window/size/min_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/godotiq/plugin.cfg")
