[gd_resource type="Resource" script_class="DateMove" load_steps=3 format=3]
[ext_resource type="Script" path="res://date_system/content/date_move.gd" id="1_move"]
[ext_resource type="Script" path="res://date_system/content/date_move_situation_mapping.gd" id="2_map"]

[sub_resource type="Resource" id="map_1"]
script = ExtResource("2_map")
situation_id = &"appearance_question"
tag_id = &"care"
option_text = "Спросить, нравится ли образ ей самой, и поддержать её выбор."
positive_result_text = "Ей это откликается. Тег «care» работает в её пользу."
negative_result_text = "Ей это режет. Тег «care» играет против вас."

[sub_resource type="Resource" id="map_2"]
script = ExtResource("2_map")
situation_id = &"money_request"
tag_id = &"generosity"
option_text = "Дать незнакомцу небольшую сумму."
positive_result_text = "Ей это откликается. Тег «generosity» работает в её пользу."
negative_result_text = "Ей это режет. Тег «generosity» играет против вас."

[sub_resource type="Resource" id="map_3"]
script = ExtResource("2_map")
situation_id = &"spontaneous_bet"
tag_id = &"politeness"
option_text = "Согласиться на предложенные девушкой правила."
positive_result_text = "Ей это откликается. Тег «politeness» работает в её пользу."
negative_result_text = "Ей это режет. Тег «politeness» играет против вас."

[sub_resource type="Resource" id="map_4"]
script = ExtResource("2_map")
situation_id = &"date_verdict"
tag_id = &"care"
option_text = "Сказать, что главное — понравился ли вечер ей самой."
positive_result_text = "Ей это откликается. Тег «care» работает в её пользу."
negative_result_text = "Ей это режет. Тег «care» играет против вас."

[resource]
script = ExtResource("1_move")
id = &"support"
display_name = "Поддержать"
description = "Поддержать"
kind = 0
enabled = true
max_uses_per_date = 0
situation_mappings = [SubResource("map_1"), SubResource("map_2"), SubResource("map_3"), SubResource("map_4")]
