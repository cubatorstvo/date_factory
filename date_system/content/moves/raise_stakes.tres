[gd_resource type="Resource" script_class="DateMove" load_steps=3 format=3]
[ext_resource type="Script" path="res://date_system/content/date_move.gd" id="1_move"]
[ext_resource type="Script" path="res://date_system/content/date_move_situation_mapping.gd" id="2_map"]
[ext_resource type="Script" path="res://date_system/content/unlock_requirement.gd" id="3_req"]

[sub_resource type="Resource" id="map_1"]
script = ExtResource("2_map")
situation_id = &"money_request"
tag_id = &"risk"
option_text = "Предложить удвоить сумму после немедленного доказательства истории."
positive_result_text = "Ей это откликается. Тег «risk» работает в её пользу."
negative_result_text = "Ей это режет. Тег «risk» играет против вас."

[sub_resource type="Resource" id="map_2"]
script = ExtResource("2_map")
situation_id = &"spontaneous_bet"
tag_id = &"risk"
option_text = "Удвоить ставку и усложнить условие проигравшему."
positive_result_text = "Ей это откликается. Тег «risk» работает в её пользу."
negative_result_text = "Ей это режет. Тег «risk» играет против вас."

[sub_resource type="Resource" id="req_1"]
script = ExtResource("3_req")
stat_id = &"capital"
required_level = 5

[resource]
script = ExtResource("1_move")
id = &"raise_stakes"
display_name = "Поднять ставки"
description = "Поднять ставки"
kind = 1
enabled = true
max_uses_per_date = 1
unlock_requirement = SubResource("req_1")
situation_mappings = [SubResource("map_1"), SubResource("map_2")]
