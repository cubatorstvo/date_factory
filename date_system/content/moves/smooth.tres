[gd_resource type="Resource" script_class="DateMove" load_steps=3 format=3]
[ext_resource type="Script" path="res://date_system/content/date_move.gd" id="1_move"]
[ext_resource type="Script" path="res://date_system/content/date_move_situation_mapping.gd" id="2_map"]

[sub_resource type="Resource" id="map_1"]
script = ExtResource("2_map")
situation_id = &"appearance_question"
tag_id = &"flattery"
option_text = "Сказать, что к её образу невозможно придраться."
positive_result_text = "Ей это откликается. Тег «flattery» работает в её пользу."
negative_result_text = "Ей это режет. Тег «flattery» играет против вас."

[sub_resource type="Resource" id="map_2"]
script = ExtResource("2_map")
situation_id = &"money_request"
tag_id = &"politeness"
option_text = "Вежливо отказать и пожелать удачи."
positive_result_text = "Ей это откликается. Тег «politeness» работает в её пользу."
negative_result_text = "Ей это режет. Тег «politeness» играет против вас."

[sub_resource type="Resource" id="map_3"]
script = ExtResource("2_map")
situation_id = &"rival_provocation"
tag_id = &"politeness"
option_text = "Предложить спокойно разойтись."
positive_result_text = "Ей это откликается. Тег «politeness» работает в её пользу."
negative_result_text = "Ей это режет. Тег «politeness» играет против вас."

[resource]
script = ExtResource("1_move")
id = &"smooth"
display_name = "Сгладить ситуацию"
description = "Сгладить ситуацию"
kind = 0
enabled = true
max_uses_per_date = 0
situation_mappings = [SubResource("map_1"), SubResource("map_2"), SubResource("map_3")]
