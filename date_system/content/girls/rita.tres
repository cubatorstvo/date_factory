[gd_resource type="Resource" script_class="GirlProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://date_system/content/girl_profile.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"rita"
display_name = "Рита"
description = "любит дорогой жест, контроль сцены и риск напоказ"
enabled = true
difficulty_preset_id = &"mid"
trait_id = &"loves_wealthy"
positive_tag_ids = Array[StringName]([&"status", &"dominance", &"generosity", &"risk"])
