positive_tag_ids = Array[StringName]([&"politeness", &"flattery", &"status", &"composure"])
negative_tag_ids = Array[StringName]([&"directness", &"audacity", &"dominance", &"risk", &"generosity", &"care", &"humor", &"cunning"])
secondary_rule_id = &"variety"
