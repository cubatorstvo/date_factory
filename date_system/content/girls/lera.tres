[gd_resource type="Resource" script_class="GirlProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://date_system/content/girl_profile.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"lera"
display_name = "Лера"
description = "любит красивую спокойную подачу, хороший вкус и социальную уверенность"
enabled = true
difficulty_preset_id = &"mid"
trait_id = &"loves_restaurants"
positive_tag_ids = Array[StringName]([&"politeness", &"flattery", &"status", &"composure"])
negative_tag_ids = Array[StringName]([&"directness", &"audacity", &"dominance", &"risk", &"generosity", &"care", &"humor", &"cunning"])
initial_known_tag_ids = Array[StringName]([&"status", &"audacity"])
