[gd_resource type="Resource" script_class="GirlProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://date_system/content/girl_profile.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"katya"
display_name = "Катя"
description = "любит спонтанность, игры, подколы и быстрые нестандартные решения"
enabled = true
difficulty_preset_id = &"mid"
trait_id = &"loves_cafe"
positive_tag_ids = Array[StringName]([&"directness", &"risk", &"humor", &"cunning"])
negative_tag_ids = Array[StringName]([&"politeness", &"flattery", &"audacity", &"dominance", &"generosity", &"status", &"care", &"composure"])
initial_known_tag_ids = Array[StringName]([&"humor", &"status"])
