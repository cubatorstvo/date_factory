[gd_resource type="Resource" script_class="GirlProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://date_system/content/girl_profile.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"eva"
display_name = "Ева"
description = "занимает зал статусом, щедрым жестом и ставкой, которую нельзя тихо отменить"
enabled = true
relationship_min = 0
relationship_start = 0
relationship_max = 10
