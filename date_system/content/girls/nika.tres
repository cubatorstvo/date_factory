[gd_resource type="Resource" script_class="GirlProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://date_system/content/girl_profile.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"nika"
display_name = "Ника"
description = "проверяет собеседника прямым ходом и обходным правилом"
enabled = true
difficulty_preset_id = &"mid"
trait_id = &"senses_aura"
positive_tag_ids = Array[StringName]([&"cunning", &"directness", &"audacity", &"composure"])
negative_tag_ids = Array[StringName]([&"politeness", &"flattery", &"dominance", &"risk", &"generosity", &"status", &"care", &"humor"])
initial_known_tag_ids = Array[StringName]([&"cunning", &"flattery"])
